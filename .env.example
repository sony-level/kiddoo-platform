# =============================================================================
# Kiddoo Platform — Environment Variables Template
# Copy to .env and fill in your values for local development.
# See docs/environments.md for per-environment details.
# =============================================================================

# --- Environment ---
ENVIRONMENT=development
RUST_LOG=debug,tower_http=debug
ROCKET_LOG_LEVEL=debug

# --- Database ---
DATABASE_URL=postgres://kiddoo:kiddoo_test_pwd@localhost:5433/kiddoo_test

# --- API Gateway ---
GATEWAY_PORT=8000
IDENTITY_PROXY_URL=http://localhost:8001
CORS_ALLOWED_ORIGINS=*

# --- Keycloak / OAuth2 ---
KEYCLOAK_URL=https://your-keycloak-server.com
KEYCLOAK_REALM=your-realm
KEYCLOAK_CLIENT_ID=your-client-id
KEYCLOAK_CLIENT_SECRET=your-client-secret

# --- OIDC / JWT Verification ---
# These are auto-derived from KEYCLOAK_URL + KEYCLOAK_REALM if not set.
# KC_ISSUER=https://your-keycloak-server.com/realms/your-realm
# KC_JWKS_URL=https://your-keycloak-server.com/realms/your-realm/protocol/openid-connect/certs
# KC_AUDIENCE=your-client-id
# KC_CLIENT_ID=your-client-id
JWKS_CACHE_TTL_SECONDS=300

# --- OAuth2 Authorization Code Flow ---
OAUTH_STATE=random-state-string
REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
FRONTEND_URL=http://localhost:3000
