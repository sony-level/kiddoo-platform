# Keycloak Configuration
KEYCLOAK_URL=https://your-keycloak-server.com
KEYCLOAK_REALM=realm_name
KEYCLOAK_CLIENT_ID=client_id_name
KEYCLOAK_CLIENT_SECRET=your-client-secret

# OIDC/JWT verification (Keycloak RS256 + JWKS)
KC_ISSUER=https://your-keycloak-server.com/realms/realm_name
KC_JWKS_URL=https://your-keycloak-server.com/realms/realms_name/protocol/openid-connect/certs
KC_AUDIENCE=audience_name
KC_CLIENT_ID=client_id_name

# Optional: JWKS cache TTL (seconds)
JWKS_CACHE_TTL_SECONDS=300

# OAuth2 Authorization Code Flow
REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
FRONTEND_URL=http://localhost:3000

# Database (inherited from workspace)
DATABASE_URL=postgres://user:password@localhost:5432/babysitting_db
