FROM jenkins/jenkins:lts-jdk17

LABEL maintainer="sony-level"

USER root

# Install Docker CLI so Jenkins master can build/run agent containers
# via the host Docker socket (mounted at /var/run/docker.sock)
RUN apt-get update && apt-get install -y \
    docker.io \
    && rm -rf /var/lib/apt/lists/* \
    && usermod -aG docker jenkins

USER jenkins
